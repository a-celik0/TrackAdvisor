@page "{id:int}"
@model TrackAdvisor.WEB.Pages.TopicDetailModel
@{
    ViewData["Title"] = @Model.Topic.Name;
}

<div class="mt-3">
    <h1 style="color: rebeccapurple;">● @Model.Topic.Name</h1>
    <p class="text-muted">@Model.Topic.Description</p>

    <a href="/ShareExperience?topicId=@Model.Topic.TopicID" class="btn btn-sm me-2" style="background-color: #e9d5ff; color: #7e22ce;">+ Share experience</a>
    <a href="/AskQuestion?topicId=@Model.Topic.TopicID" class="btn btn-sm" style="background-color: #e9d5ff; color: #7e22ce;">+ Ask a question</a>

    <hr class="mt-4" />

    <h3 class="mt-4">Experiences (@Model.ExperiencePosts.Count)</h3>
    @foreach (var post in Model.ExperiencePosts)
    {
        <div class="card mb-3" style="border-color: #c084fc; background-color: #f3e8ff;">
            <div class="card-body">
                <p class="card-text">@post.Content</p>
                <small class="text-muted">@post.CreatedAt</small>
            </div>
        </div>
    }

    <h3 class="mt-4">Questions (@Model.Questions.Count)</h3>
    @foreach (var question in Model.Questions)
    {
        <div class="card mb-3" style="border-color: #c084fc; background-color: #f3e8ff;">
            <div class="card-body">
                <p class="card-text">@question.Content</p>
                <small class="text-muted">@question.CreatedAt</small>

                <!-- Answers for this question -->
                @foreach (var answer in Model.Answers.Where(a => a.QuestionID == question.QuestionID))
                {
                    <div class="mt-2 p-2 rounded" style="background-color: #ede9fe;">
                        <p class="mb-1">@answer.Content</p>
                        <small class="text-muted">@answer.CreatedAt</small>
                    </div>
                }

                <a href="/AddAnswer?questionId=@question.QuestionID&topicId=@Model.Topic.TopicID" class="btn btn-sm mt-2" style="background-color: #e9d5ff; color: #7e22ce;">+ Answer</a>
            </div>
        </div>
    }
</div>
@page
@model TrackAdvisor.WEB.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}
<!-- Bootstrap container: used to center the page -->
<div class="container d-flex justify-content-center align-items-center vh-100">
    <!-- Bootstrap card: register box -->
    <div class="card shadow" style="width:420px; border-radius:15px;">
        <!-- Card header: purple TrackAdvisor title at the top -->
        <div class="card-header text-white fw-bold fs-4"
             style="background-color:#7030a0; border-radius:15px 15px 0 0;">
            Track<span class="times new roman">Advisor</span>
        </div>
        <!-- Card body: form area -->
        <div class="card-body">
            <!-- Page title -->
            <h3 class="fw-bold">Create account</h3>
            <!-- Small description -->
            <p class="text-muted">Join the Fontys TrackAdvisor community</p>
            <!-- Register form -->
            <form method="post">
                <!-- Email input -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <!-- asp-for binds this input to the Email property via Razor model binding -->
                    <!-- required: form cannot be submitted empty -->
                    <!-- type="email": browser checks for valid email format -->
                    <input asp-for="Email" type="email" class="form-control" placeholder="you@fontys.nl" required>
                </div>
                <!-- Password input -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <!-- type=password: hides the characters -->
                    <!-- required: form cannot be submitted empty -->
                    <input asp-for="Password" type="password" class="form-control" required>
                </div>
                <!-- Confirm password input -->
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" required>
                </div>
                <!-- Show error message if there is one -->
                @if (!string.IsNullOrEmpty(Model.Message))
                {
                    <!-- Bootstrap alert component -->
                    <div class="alert alert-danger">
                        @Model.Message
                    </div>
                }
                <!-- Register button -->
                <button type="submit" class="btn btn-outline-secondary w-100 fw-bold">
                    Create account
                </button>
            </form>
            <!-- Link to login page -->
            <p class="text-center mt-3">
                <!-- asp-page uses Razor routing -->
                Already have an account?
                <a asp-page="/Login">Log in</a>
            </p>
        </div>
    </div>
</div>
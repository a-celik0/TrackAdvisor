@page
@model TrackAdvisor.WEB.Pages.ShareExperienceModel
<div class="container mt-4">
    <h2>Share Experience</h2>
    <form method="post">
        <input type="hidden" asp-for="TopicID" />
        <div>
            <label>Your Experience</label>
            <!-- required: form cannot be submitted empty -->
            <!-- maxlength: limits input to 1000 characters -->
            <textarea asp-for="Content" rows="5" class="form-control" required maxlength="1000"></textarea>
        </div>
        <br />
        <button type="submit">Submit</button>
    </form>
</div>
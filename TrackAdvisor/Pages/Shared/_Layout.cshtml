<!DOCTYPE html>
 <!-- HTML5 document type -->
<html lang="en">
 <!-- Sayfanın dili İngilizce -->
<head>
    <meta charset="utf-8" /> <!-- Karakter encoding (ö, ç gibi karakterler için) -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <!-- Mobil cihazlarda responsive görünüm sağlar -->

    <title>@ViewData["Title"] - TrackAdvisor</title> <!-- Sayfa başlığı. Her sayfa kendi Title değerini verebilir -->

    <script type="importmap"></script> <!-- JavaScript module import mapping için kullanılır (modern JS desteği) -->
    <!-- Bootstrap CSS framework (hazır tasarım ve responsive layout için) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Projenin ana CSS dosyası -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Projeye özel Razor style bundle -->
    <link rel="stylesheet" href="~/TrackAdvisor.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <!-- Navbar (üst menü). Bootstrap kullanılarak responsive navigation oluşturulur -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom shadow-sm">
            <div class="container">
                <!-- İçeriği ortalamak için Bootstrap container -->
                <!-- Logo / site adı. Tıklanınca ana sayfaya gider -->
                <a class="navbar-brand fw-bold" asp-area="" asp-page="/Index">TrackAdvisor</a>

                <!-- Mobil ekranlarda menüyü açıp kapatan buton -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menü linklerinin bulunduğu alan -->
                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- Navigation list -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Home sayfasına gider -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                        </li>

                        <!-- Topics sayfasına gider -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Topics">Topics</a>
                        </li>

                        @if (Context.Request.Cookies["UserID"] != null)
                        {
                            <!-- Kullanıcı giriş yapmış — sadece Logout göster -->
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <!-- Kullanıcı giriş yapmamış — Register ve Login göster -->
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Register">Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Login">Login</a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Ana içerik alanı -->
    <main class="container mt-4">
        @RenderBody() <!-- Her Razor Page'in kendi içeriği burada render edilir -->
    </main>

    <!-- Sayfanın alt kısmı -->
    <footer class="border-top text-muted mt-5 py-3">
        <div class="container">
            &copy; 2026 - TrackAdvisor <!-- Copyright -->
        </div>
    </footer>

    <!-- jQuery library (Bootstrap bazı özellikleri için kullanabilir) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap JavaScript bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Projeye özel JavaScript dosyası -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Eğer bir sayfa ekstra script kullanıyorsa buraya eklenir -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@page "/"
@model TrackAdvisor.WEB.Pages.TopicsModel
@{
    ViewData["Title"] = "Topics";
}

<!-- Hero section: full-width purple banner -->
<div style="background-color: #7030a0; color: white; padding: 60px 20px; border-radius: 12px; text-align: center; margin-bottom: 30px;">
    <h1 style="font-weight: bold; font-size: 2.5rem;">Find your perfect specialization track</h1>
    <p style="font-size: 1.1rem; max-width: 600px; margin: 20px auto;">
        Read real student experiences, ask questions, and make informed decisions about your semester specialization at Fontys.
    </p>
</div>

<h2 class="mb-4">All Specialization Topics</h2>
<div class="row">
    @foreach (var topic in Model.Topics)
    {
        <div class="col-md-6 mb-4">
            <div class="card h-100" style="border-color: #c084fc;">
                <div class="card-body" style="background-color: white;">
                    <h3 class="card-title">
                        <a href="/TopicDetail/@topic.TopicID" style="color: rebeccapurple; text-decoration: none;">
                            @topic.Name
                        </a>
                    </h3>
                    <p class="card-text text-muted">@topic.Description</p>
                    <a href="/TopicDetail/@topic.TopicID" class="btn btn-sm mt-2" style="background-color: #e9d5ff; color: rebeccapurple;">
                        View Topic →
                    </a>
                </div>
            </div>
        </div>
    }
</div>